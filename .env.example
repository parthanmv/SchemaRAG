# =============================================================================
# SchemaRAG environment configuration (template)
# Copy this file to `.env` at the repository root and adjust the values.
#   cp .env.example .env
# NEVER commit the real .env file - it is gitignored on purpose.
# =============================================================================

# --- PostgreSQL connection used by the FastAPI backend / SQLAlchemy ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=college_db
DB_USER=schemarag
DB_PASSWORD=change_me_strongly

# Echo SQLAlchemy SQL statements (true/false). Leave false in normal use.
DB_ECHO=false

# --- Phase 3: local embedding model + FAISS index (no API keys required) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_INDEX_DIR and RAG_OUTPUT_DIR default to <repo>/rag/index and <repo>/rag.
# RAG_INDEX_DIR=rag/index

# --- Phase 4.1: LLM provider for Text-to-SQL (Google Gemini) ---
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
# Secret! Get a key at https://aistudio.google.com/apikey
# Never commit the real .env or share the key.
GEMINI_API_KEY=change_me_gemini_api_key

# Optional generation timeout in seconds (default 120)
# LLM_TIMEOUT_SECONDS=120

# Legacy local fallback - only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Phase 5: read-only SQL execution (POST /api/query) ---
# Created automatically by: python -m app.scripts.setup_readonly_role
# (which writes the real values into .env). Leave empty to keep
# execution disabled; /api/generate-sql keeps working either way.
EXEC_DB_USER=
EXEC_DB_PASSWORD=

# Optional execution limits (defaults shown)
# SQL_MAX_ROWS=500
# SQL_STATEMENT_TIMEOUT_MS=5000
